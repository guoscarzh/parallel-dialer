# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555555555
# Account -> API keys -> Create (Standard). Used for the browser softphone token.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=

# Public URL Twilio can reach (your ngrok https URL, no trailing slash)
PUBLIC_URL=https://xxxx.ngrok-free.app
# Set to false only if webhook signature checks fail while debugging
TWILIO_VALIDATE_WEBHOOKS=true

# Lead source: csv | scrapercity
LEAD_SOURCE=csv
SCRAPERCITY_API_KEY=

# AI brief (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
SDR_NAME=
SDR_PITCH=

# ScraperCity spend guards (pulls are locked unless ALLOW_SPEND=true; total spend capped)
SCRAPERCITY_ALLOW_SPEND=false
SCRAPERCITY_MAX_SPEND_DOLLARS=1

# Answering machine detection (needs an upgraded Twilio account)
TWILIO_AMD=true

# Simulated calls for demos (no Twilio needed); switchable in the UI
SIMULATE_CALLS=false
# Startup call mode: live (Twilio), web (WebRTC calls to phones that open /phone) or sim (practice)
CALL_MODE=live
